# Place inside nginx's http context (e.g. /etc/nginx/conf.d/rice.conf).
# Replace YOUR_DOMAIN before use. Add HTTPS before using this on a phone.
# Proxy the whole site, so the UI and API remain on the same origin.
server {
    listen 80;
    server_name YOUR_DOMAIN;

    client_max_body_size 20m;
    client_body_timeout 45s;
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # Crucial: stream uploaded bytes instead of buffering images to disk.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 120s;
        proxy_send_timeout 60s;
    }
}
